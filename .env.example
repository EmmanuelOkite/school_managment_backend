# Copy this file to .env and fill in real values. .env is git-ignored.

# Database (currently has hardcoded dev fallbacks in src/app.module.ts - set
# these explicitly for any non-local environment)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=school_db

# Auth
# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional, defaults to 1d. Examples: 1h, 12h, 7d
JWT_EXPIRES_IN=1d

# Used only by `npm run seed:admin` (scripts/seed-admin.ts) to create/reset the
# first admin login until a real account-creation API exists. Not read by the
# app itself.
ADMIN_EMAIL=
ADMIN_PASSWORD=
